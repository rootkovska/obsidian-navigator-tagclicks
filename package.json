{
  "name": "nn-tag-click",
  "version": "0.1.0",
  "description": "Obsidian plugin: clicking a tag in a note reveals it in Notebook Navigator's tag tree.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && wdio run tests/e2e/wdio.conf.mts",
    "test:e2e:mobile": "npm run build && NN_E2E_MOBILE=1 wdio run tests/e2e/wdio.conf.mts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wdio-obsidian-service": "^3.3.0",
    "webdriverio": "^9.32.0"
  }
}
